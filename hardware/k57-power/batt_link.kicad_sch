r_SMD:C_0603_1608Metric" (at 355.6 198.12 0) (hide yes) (effects (font (size 1.27 1.27)))) (property "Datasheet" "" (at 355.6 198.12 0) (hide yes) (effects (font (size 1.27 1.27)))) (pin "1" (uuid "dbd63145-71f9-4585-81fa-dd79acd0de56")) (pin "2" (uuid "34825244-41d0-45b2-b5c9-2b53fe04a8be")) (instances (project "k57-power" (path "/9ca3d279-366b-4cef-96de-247a27f63fb0/9e0fe6bd-a782-403c-baea-ed8edb043eb8" (reference "C513") (unit 1))))) (label "VBIAS_1V5" (at 355.6 194.31 90) (fields_autoplaced yes) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "e4f62b6d-23bd-4ba9-9a69-7299f4f099ee")) (symbol (lib_id "power:GND") (at 355.6 201.93 0) (unit 1) (exclude_from_sim no) (in_bom yes) (on_board yes) (dnp no) (uuid "3052da94-66af-42b1-b80b-17c58cd0aa58") (property "Reference" "#PWR046" (at 355.6 201.93 0) (hide yes) (effects (font (size 1.27 1.27)))) (property "Value" "GND" (at 355.6 205.74 0) (effects (font (size 1.27 1.27)))) (property "Footprint" "" (at 355.6 201.93 0) (hide yes) (effects (font (size 1.27 1.27)))) (property "Datasheet" "" (at 355.6 201.93 0) (hide yes) (effects (font (size 1.27 1.27)))) (pin "1" (uuid "0db2605b-57c3-4572-a78f-d45c2f6fabed")) (instances (project "k57-power" (path "/9ca3d279-366b-4cef-96de-247a27f63fb0/9e0fe6bd-a782-403c-baea-ed8edb043eb8" (reference "#PWR046") (unit 1))))) (text "ПОДКЛЮЧЕНИЕ АКБ (техзадание 6.4)\nСверху - плюс АКБ (BAT_POS, клемма J301 после внешнего предохранителя класса T 150 А), снизу - плюс звена (DC_POS, J302).\nK301 - главный контактор 200 А / 60 В на шасси, болтами между J301 и J302: на плату и в закупку не входит,\n  нарисован для наглядности. Контактор и предзаряд - только в ПЛЮСЕ: минус АКБ - земля платы управления.\nПредзаряд - параллельно контактору: Q301 (P-MOSFET 100 В) + резистор 22-33 Ом / 50 Вт на радиаторе (клеммы J303).\n  Закрыт: R301 держит затвор у истока. PRECHARGE_EN = 1 -> Q302 тянет затвор вниз через R302,\n  D301 (12 В) ограничивает Uзи. Ток через R301/R302 около 5 мА при 60 В.\n  [?] IRF9540N - кандидат; проверить импульс энергии предзаряда (~85 Дж) по SOA.\nКатушка контактора: J304, Q303 от CONTACTOR_EN, D302 - диод на катушке.\nF301 2 А -> VBAT_RAW: питание платы управления до контактора, иначе МК не управлял бы предзарядом.\nD303 - TVS на звене; ключи он не защищает (ограничение выше 100 В), гасит выброс кабелей. [?]\niBat: минус АКБ (J502) -> шунт R511 0,2 мОм -> GND платы (минус звена). Измерение - как у Ia на листе «Мост»:\n  выводы 2 и 3 шунта - отдельными дорожками, R512/R513 (0 Ом), C511 (не запаивать), U511 INA240A1.\n  IN+ - со стороны GND: разряд АКБ -> сигнал выше 1,5 В. +-250 А -> 1,5 +- 1,0 В.\nПоследовательность (прошивка): предзаряд -> DC+ >= ~90 % BAT+ -> контактор; не дождались - авария." (exclude_from_sim no) (at 76.2 246.38 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "a541b723-1db6-48d1-acd0-9ce7f5156534")) (embedded_fonts no))