ard yes) (dnp no) (uuid "a15539d1-c1a6-4418-bd79-bb6d9764cd02") (property "Reference" "C551" (at 407.67 222.25 0) (effects (font (size 1.27 1.27)) (justify left))) (property "Value" "100nF" (at 407.67 224.79 0) (effects (font (size 1.27 1.27)) (justify left))) (property "Footprint" "Capacitor_SMD:C_0603_1608Metric" (at 403.86 223.52 0) (hide yes) (effects (font (size 1.27 1.27)))) (property "Datasheet" "" (at 403.86 223.52 0) (hide yes) (effects (font (size 1.27 1.27)))) (pin "1" (uuid "f36f005c-4c06-4a5b-a4b6-d56f462c559e")) (pin "2" (uuid "5d353f21-37d2-4bfc-93bf-f0324d1841c3")) (instances (project "k57-power" (path "/9ca3d279-366b-4cef-96de-247a27f63fb0/beb70ec7-0169-4065-881e-156d328c29b9" (reference "C551") (unit 1))))) (label "+3V3A" (at 403.86 219.71 90) (fields_autoplaced yes) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "09df5c86-dccb-48c1-a0c3-204faf3c752f")) (symbol (lib_id "power:GND") (at 403.86 227.33 0) (unit 1) (exclude_from_sim no) (in_bom yes) (on_board yes) (dnp no) (uuid "e336bd6a-ba22-401a-b51b-0fe1eb00d1ac") (property "Reference" "#PWR088" (at 403.86 227.33 0) (hide yes) (effects (font (size 1.27 1.27)))) (property "Value" "GND" (at 403.86 231.14 0) (effects (font (size 1.27 1.27)))) (property "Footprint" "" (at 403.86 227.33 0) (hide yes) (effects (font (size 1.27 1.27)))) (property "Datasheet" "" (at 403.86 227.33 0) (hide yes) (effects (font (size 1.27 1.27)))) (pin "1" (uuid "76f65342-31cb-4efc-883c-cd86c9ac8357")) (instances (project "k57-power" (path "/9ca3d279-366b-4cef-96de-247a27f63fb0/beb70ec7-0169-4065-881e-156d328c29b9" (reference "#PWR088") (unit 1))))) (text "ИЗМЕРЕНИЯ 48 В (техзадание 6.5)\nIa: шунт R501 0,2 мОм между PHASE_B и клеммой трансформатора J501 (XFMR_B) + U501 INA240A1 (x20).\niBat: шунт R511 между клеммой J502 (BAT-) и GND + U511 INA240A1. GND платы - минус звена.\n  REF1/REF2 = VBIAS_1V5 от REF2030 на плате управления: нуль и шкала АЦП от одной опоры.\n  Шкала +-250 А -> 1,5 +- 1,0 В. R502/R503 (0 Ом) и C501 (не запаивать) - место под фильтр.\n  Знак тока задаёт прошивка (gt.iSign); измерительные выводы шунтов - отдельными дорожками.\n  [?] Посадочное место шунта 5930 с четырёхпроводным подключением - создать.\nuBat (звено, после контактора) и uBatt (клеммы АКБ): 2 x 120 кОм + 10 кОм 0,1 %, 75 В -> 3,0 В,\n  4,7 нФ (~3,5 кГц) + повторитель U521 (TLV9064): сигнал по кабелю идёт с низким сопротивлением.\n  uBat идёт и на компаратор защиты от перенапряжения (CMPSS1 на плате управления).\nNTC радиатора 10 кОм B3950 (J503): делитель от VREF_3V0, повторитель. Секция D U521 не используется.\nВыходы - через 47 Ом к разъёму; RC перед АЦП - на плате управления." (exclude_from_sim no) (at 81.28 238.76 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "e46b1f2a-5b14-425b-8357-d707be902cfb")) (embedded_fonts no))