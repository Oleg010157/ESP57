b-65dd-4c1b-a320-a74ccbfef576")) (pin "2" (uuid "008a76e5-42d7-4ed4-ac13-7a6c00db5828")) (instances (project "k57-power" (path "/9ca3d279-366b-4cef-96de-247a27f63fb0/85535415-748e-404d-bd82-5ce9d9b9e663" (reference "C116") (unit 1))))) (symbol (lib_id "power:+12V") (at 182.88 204.47 0) (unit 1) (exclude_from_sim no) (in_bom yes) (on_board yes) (dnp no) (uuid "d729f5f0-7b20-4a9a-84ed-a7cf7f7d6f96") (property "Reference" "#PWR027" (at 182.88 204.47 0) (hide yes) (effects (font (size 1.27 1.27)))) (property "Value" "+12V" (at 182.88 200.66 0) (effects (font (size 1.27 1.27)))) (property "Footprint" "" (at 182.88 204.47 0) (hide yes) (effects (font (size 1.27 1.27)))) (property "Datasheet" "" (at 182.88 204.47 0) (hide yes) (effects (font (size 1.27 1.27)))) (pin "1" (uuid "012d13b9-8db4-4282-a7f8-aa9a0da3da70")) (instances (project "k57-power" (path "/9ca3d279-366b-4cef-96de-247a27f63fb0/85535415-748e-404d-bd82-5ce9d9b9e663" (reference "#PWR027") (unit 1))))) (symbol (lib_id "power:GND") (at 182.88 212.09 0) (unit 1) (exclude_from_sim no) (in_bom yes) (on_board yes) (dnp no) (uuid "9860dddd-7c1f-4155-9d21-139cd592d622") (property "Reference" "#PWR028" (at 182.88 212.09 0) (hide yes) (effects (font (size 1.27 1.27)))) (property "Value" "GND" (at 182.88 215.9 0) (effects (font (size 1.27 1.27)))) (property "Footprint" "" (at 182.88 212.09 0) (hide yes) (effects (font (size 1.27 1.27)))) (property "Datasheet" "" (at 182.88 212.09 0) (hide yes) (effects (font (size 1.27 1.27)))) (pin "1" (uuid "33414f7b-defa-4bca-9bc2-b24f68dd5c21")) (instances (project "k57-power" (path "/9ca3d279-366b-4cef-96de-247a27f63fb0/85535415-748e-404d-bd82-5ce9d9b9e663" (reference "#PWR028") (unit 1))))) (text "ДРАЙВЕРЫ ЗАТВОРОВ (техзадание 6.2)\nU101 - плечо A (EPWM1), U102 - плечо B (EPWM2). Уровень 1 = ключ открыт (IGBT_ACTIVE_HIGH = 1).\nВходы HI/LI/EN: 47 Ом последовательно + 10 кОм к земле - пока МК в сбросе, ключи закрыты.\nEN: 1 нФ к земле - рекомендация TI для зашумлённых систем.\nБутстреп: 2 затвора x 330 нК + утечки за самый длинный импульс (~195 мкс) = ~0,83 мкКл;\n  просадка <= 0,5 В -> >= 1,7 мкФ; 4,7 мкФ X7R 25 В (под 12 В ~2,8 мкФ) + 1 нФ рядом.\nПитание: 22 мкФ + 1 мкФ + 1 нФ у VDD-VSS (>= 10 x бутстреп).\nТеплоотводящая площадка (EP) - только к VSS. Драйвер - вплотную к ключам своего плеча,\nHS - к истокам верхних ключей кратчайшим путём." (exclude_from_sim no) (at 81.28 236.22 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "2b50dd19-f38a-437d-beee-54ed7e093cfe")) (embedded_fonts no))