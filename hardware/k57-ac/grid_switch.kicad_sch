 "6b0d3207-8aa5-4985-a987-032a0819c131")) (wire (pts (xy 177.8 165.1) (xy 233.68 165.1)) (stroke (width 0) (type default)) (uuid "746623c2-b9a1-426c-84dc-51cf9969320b")) (junction (at 210.82 165.1) (diameter 0) (color 0 0 0 0) (uuid "c0ebaa04-20bf-4bda-a8ed-273204ace0ae")) (symbol (lib_id "Connector:Screw_Terminal_01x02") (at 248.92 139.7 0) (unit 1) (exclude_from_sim no) (in_bom yes) (on_board yes) (dnp no) (uuid "4546b95a-db30-49d6-843a-fac2afdb094b") (property "Reference" "J201" (at 246.38 132.08 0) (effects (font (size 1.27 1.27)) (justify left))) (property "Value" "Сеть / нагрузка (через внешний автомат)" (at 246.38 134.62 0) (effects (font (size 1.27 1.27)) (justify left))) (property "Footprint" "TerminalBlock_Phoenix:TerminalBlock_Phoenix_MKDS-3-2-5.08_1x02_P5.08mm_Horizontal" (at 248.92 139.7 0) (hide yes) (effects (font (size 1.27 1.27)))) (property "Datasheet" "" (at 248.92 139.7 0) (hide yes) (effects (font (size 1.27 1.27)))) (pin "1" (uuid "c01b5ecd-e24c-439d-8080-b3117b5ba371")) (pin "2" (uuid "0a09be89-3f21-411f-aff3-a0eca529036e")) (instances (project "k57-ac" (path "/89bc2ed6-8799-4d08-a775-61331e1e87f5/48d8a853-4828-4c1a-95ec-9c23e5259386" (reference "J201") (unit 1))))) (wire (pts (xy 238.76 114.3) (xy 238.76 139.7)) (stroke (width 0) (type default)) (uuid "47efd8ed-3d7b-400d-8388-3876a9f7671e")) (wire (pts (xy 238.76 139.7) (xy 243.84 139.7)) (stroke (width 0) (type default)) (uuid "cd24a89f-4a90-4e4b-bbd2-f56c32ba8de5")) (wire (pts (xy 233.68 165.1) (xy 233.68 142.24)) (stroke (width 0) (type default)) (uuid "55d145d2-7797-4168-8c4b-142e5a9a262d")) (wire (pts (xy 233.68 142.24) (xy 243.84 142.24)) (stroke (width 0) (type default)) (uuid "857f3aff-384f-4797-a852-2bfd122fe388")) (text "СЕТЕВОЙ КОНТАКТОР И ЗАЩИТА (техзадание 6.6)\nЛиния L: OUT_L (после синус-фильтра) -> окно ТТ T201 -> контакт K201 -> GRID_L -> J201. Линия N - так же через K202.\nK201 (L) и K202 (N) - реле Panasonic LF-G ALFG2PF12: 22 А, зазор контактов 1,8 мм, сделаны для солнечных инверторов.\n  Разрываются оба провода. Катушки 12 В соединены параллельно, включает их Q201 по GRID_CONT_EN (GPIO59).\n  R202 держит Q201 закрытым при сбросе МК и без шлейфа: реле по умолчанию разомкнуты. D201/D202 - на выбег катушек.\n  [?] Ток катушки LF-G ~117 мА (1,4 Вт); удержание можно снизить ШИМ - пока не нужно.\nT201 - трансформатор тока Ib 1:1000: провод OUT_L проходит через окно (до реле - ток инвертора в обоих режимах).\n  Нагрузка ТТ и защита - на листе «Измерения 230 В». [?] Модель ТТ: шкала ±40 А пик, класс ZMCT103C мал - подобрать.\nRV201 S20K275 - варистор от сетевых выбросов, у клемм J201.\nПредохранителя на плате нет: держатель 5x20 мм не держит 14,5 А длительно. Защита от КЗ - внешний\n  автомат C20 между J201 и сетью. [?] Подтвердить (раздел 8 техзадания)." (exclude_from_sim no) (at 63.5 200.66 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "a12855a7-e5f0-48d8-b4df-55b1d0320542")) (embedded_fonts no))