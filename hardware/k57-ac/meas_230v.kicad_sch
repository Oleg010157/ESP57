(kicad_sch (version 20250610) (generator "eeschema") (generator_version "10.0") (uuid "d20b0dcf-00fd-4258-b756-2feeff9d933a") (paper "A4") (title_block (title "K57 плата 230 В: Измерения 230 В") (date "2026-11-24") (rev "0.1 структура") (comment 1 "Синус-фильтр, сетевой контактор, измерения 230 В") (comment 2 "Техзадание: docs/k57-power-stage-spec-RU.md")) (lib_symbols) (hierarchical_label "OUT_L" (shape passive) (at 25.40 30.48 180) (effects (font (size 1.27 1.27)  ) (justify right)) (uuid "4ceb41d6-8761-4847-b3a7-9d51cc732c64")) (hierarchical_label "OUT_N" (shape passive) (at 25.40 35.56 180) (effects (font (size 1.27 1.27)  ) (justify right)) (uuid "af57047f-1e2e-4b38-a1fb-ce66c8bb7535")) (hierarchical_label "GRID_L" (shape passive) (at 25.40 40.64 180) (effects (font (size 1.27 1.27)  ) (justify right)) (uuid "c663520c-06ec-4a0c-bbd0-38dc20efecb4")) (hierarchical_label "GRID_N" (shape passive) (at 25.40 45.72 180) (effects (font (size 1.27 1.27)  ) (justify right)) (uuid "fcef29e2-ea98-4cd3-b314-2612caa4df1d")) (hierarchical_label "IB_CT_P" (shape passive) (at 25.40 50.80 180) (effects (font (size 1.27 1.27)  ) (justify right)) (uuid "ae937c10-f1ee-4e53-a3ee-c651394e977f")) (hierarchical_label "IB_CT_N" (shape passive) (at 25.40 55.88 180) (effects (font (size 1.27 1.27)  ) (justify right)) (uuid "15f6c2b6-30f8-4abc-a1aa-471a6b18b2fd")) (hierarchical_label "+3V3A" (shape passive) (at 25.40 60.96 180) (effects (font (size 1.27 1.27)  ) (justify right)) (uuid "3dc54d44-6660-4ea9-a8a4-caddd46f7178")) (hierarchical_label "GND" (shape passive) (at 25.40 66.04 180) (effects (font (size 1.27 1.27)  ) (justify right)) (uuid "f88a685c-3252-4bad-beb0-f6e92f1d73eb")) (hierarchical_label "IB_P" (shape output) (at 25.40 71.12 180) (effects (font (size 1.27 1.27)  ) (justify right)) (uuid "d441944c-dad0-4ade-9195-c95faee4fb99")) (hierarchical_label "IB_N" (shape output) (at 25.40 76.20 180) (effects (font (size 1.27 1.27)  ) (justify right)) (uuid "f3c94be7-699e-43ff-8c61-556e88c516dd")) (hierarchical_label "U220_P" (shape output) (at 25.40 81.28 180) (effects (font (size 1.27 1.27)  ) (justify right)) (uuid "ed41c2fd-f0b1-4dba-a5dc-3b0b121ecc02")) (hierarchical_label "U220_N" (shape output) (at 25.40 86.36 180) (effects (font (size 1.27 1.27)  ) (justify right)) (uuid "cc677201-6e10-4889-ada2-f1be4ea00c5e")) (hierarchical_label "USEC_P" (shape output) (at 25.40 91.44 180) (effects (font (size 1.27 1.27)  ) (justify right)) (uuid "6f50718b-ab19-4942-9be9-3da882bbd1a0")) (hierarchical_label "USEC_N" (shape output) (at 25.40 96.52 180) (effects (font (size 1.27 1.27)  ) (justify right)) (uuid "5160d7f1-6b74-400d-85a2-8b5a6cd2199f")) (text "Выводы листа (иерархические метки) — слева.\nСейчас лист пустой: это структура. Схема — следующим шагом." (exclude_from_sim no) (at 25.40 20.32 0) (effects (font (size 1.27 1.27)  ) (justify left top)) (uuid "ed9b99a0-fb51-4dc9-8159-b784587c9da2")) (text "ИЗМЕРЕНИЯ 230 В - ИЗОЛЯЦИОННЫЙ БАРЬЕР (техзадание 6.5, 6.6)\n\nИзоляция между 230 В и выходами листа - УСИЛЕННАЯ: земля управления\nсоединена с минусом АКБ, а его можно коснуться. Пути утечки ~5-6,5 мм\n[?] по IEC 61800-5-1 / IEC 62109-1. Под AMC3330 - прорезь в плате.\n\n- U220 = GRID_L - GRID_N (сеть, после контактора): делитель + AMC3330.\n- USEC = OUT_L - OUT_N: ПОСЛЕ синус-фильтра (после L2), до контактора.\n  По нему - регулятор напряжения в режиме АИН и сравнение с U220 перед\n  замыканием контактора. Делитель + AMC3330.\n  AMC3330 питается от +3V3A низкой стороны, высокую сторону питает сам\n  (встроенный изолированный DC/DC). Выход - дифференциальная пара.\n- IB: нагрузочный резистор трансформатора тока, напряжение на нём -\n  дифференциальной парой. Смещение 1,65 В - на плате управления." (exclude_from_sim no) (at 106.68 30.48 0) (effects (font (size 1.27 1.27)  ) (justify left top)) (uuid "47b1c2cd-8a98-4f0c-9aae-5f3a2040f3f0")) (embedded_fonts no))