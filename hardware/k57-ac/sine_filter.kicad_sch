19")) (symbol (lib_id "Connector:Screw_Terminal_01x02") (at 254.0 101.6 0) (unit 1) (exclude_from_sim no) (in_bom yes) (on_board yes) (dnp no) (uuid "a4927810-b58e-41c1-94d8-8ded1a27a287") (property "Reference" "J102" (at 254.0 91.44 0) (effects (font (size 1.27 1.27)))) (property "Value" "К дросселю L2 (на шасси)" (at 254.0 93.98 0) (effects (font (size 1.27 1.27)))) (property "Footprint" "TerminalBlock_Phoenix:TerminalBlock_Phoenix_MKDS-3-2-5.08_1x02_P5.08mm_Horizontal" (at 254.0 101.6 0) (hide yes) (effects (font (size 1.27 1.27)))) (property "Datasheet" "" (at 254.0 101.6 0) (hide yes) (effects (font (size 1.27 1.27)))) (pin "1" (uuid "7b46e0bd-ba3c-4160-996a-58edc19dbdff")) (pin "2" (uuid "d22826b5-a0dd-4b2e-b0dc-670b6f4744e1")) (instances (project "k57-ac" (path "/89bc2ed6-8799-4d08-a775-61331e1e87f5/b2e0532d-72c0-4b08-bedd-885857edab67" (reference "J102") (unit 1))))) (wire (pts (xy 248.92 101.6) (xy 246.38 101.6)) (stroke (width 0) (type default)) (uuid "bedc3ad9-72b0-41f7-88a1-2dc3b55a9d52")) (label "XS_L" (at 246.38 101.6 180) (fields_autoplaced yes) (effects (font (size 1.27 1.27)) (justify right bottom)) (uuid "d1913fc5-ff86-4ddf-9c2c-00cf0a060f63")) (wire (pts (xy 248.92 104.14) (xy 246.38 104.14)) (stroke (width 0) (type default)) (uuid "fa1567c6-690b-499d-b532-5768fd0bbcaa")) (label "OUT_L" (at 246.38 104.14 180) (fields_autoplaced yes) (effects (font (size 1.27 1.27)) (justify right bottom)) (uuid "5ffd9fd1-08b4-4da8-bdbd-1816fae521e2")) (text "СИНУС-ФИЛЬТР LCL (техзадание 6.8) - и для режима АИН, и для работы на сеть\nL1 - рассеяние трансформатора, отдельного дросселя нет. [?] Требование к трансформатору: 3-5 мГн к вторичке.\nC = C101 + C102 = 2 мкФ, плёнка X2 310 В~ (класс WIMA MKP-X2, шаг 22,5 мм). R101 8,2 Ом 10 Вт - демпфирование\n  резонанса (~1/(3*w*C)); пульсации 10 кГц греют его на ~4 Вт. Конденсатор разряжается через обмотку трансформатора.\nL2 - сетевой дроссель 1,5 мГн, 13-15 А действующих, на шасси: J102.1 - начало, J102.2 - конец.\nOUT_L / OUT_N - выход после всего фильтра: к реле сети и к датчику uSec (лист «Измерения 230 В»).\n[?] Номиналы - проверить моделью, когда будет трансформатор. ЭМС-фильтр (150 кГц - 30 МГц) - не нарисован.\nВсё на листе - под сетевым напряжением: зазоры и пути утечки - как для 230 В." (exclude_from_sim no) (at 63.5 165.1 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "fb460928-a662-47ee-bcc9-716933b1d759")) (embedded_fonts no))