ac" (path "/89bc2ed6-8799-4d08-a775-61331e1e87f5/52ccb393-8add-4e6d-9e9a-e8251fac7b8c" (reference "#FLG403") (unit 1))))) (wire (pts (xy 304.8 96.52) (xy 304.8 101.6)) (stroke (width 0) (type default)) (uuid "03c30629-0a2d-432c-bb0e-f95814394a79")) (label "+3V3A" (at 304.8 101.6 270) (fields_autoplaced yes) (effects (font (size 1.27 1.27)) (justify right bottom)) (uuid "b5940dd4-d45e-46fc-91bd-d2b0ef7a4b49")) (text "РАЗЪЁМ К ПЛАТЕ УПРАВЛЕНИЯ (k57-control, лист «Разъём к плате 230 В», J801)\nJ401 - IDC 2x8, плоский шлейф, контакт 1 - в контакт 1. Распиновка - общая (hardware/tools/k57_links.py, AC_LINK),\n  сверяется скриптом check_links.py. Провода по порядку: 1 GND, 2-3 Ib, 4 GND, 5-6 U220, 7 GND, 8-9 uSec, 10 GND,\n  11 GRID_CONT_EN, 12 GND, 13 +3V3A, 14 GND, 15-16 +12V. Каждая дифференциальная пара - соседние провода.\nВсё на этом листе - низковольтное, по ту сторону барьера от 230 В.\nPWR_FLAG - пометка для проверки схемы: питание приходит с платы управления." (exclude_from_sim no) (at 81.28 165.1 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "bb0821d2-076f-40c1-b271-46d4b8774a93")) (embedded_fonts no))