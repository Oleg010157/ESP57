-a0f4-8cc223ddae63")) (hierarchical_label "VREF_3V3" (shape passive) (at 25.40 81.28 180) (effects (font (size 1.27 1.27)  ) (justify right)) (uuid "43482ee3-3e30-490f-a442-543001fcd8a9")) (hierarchical_label "GND" (shape passive) (at 25.40 86.36 180) (effects (font (size 1.27 1.27)  ) (justify right)) (uuid "bf001b80-9811-4704-96ab-c317a5efa007")) (hierarchical_label "IA_OUT" (shape output) (at 25.40 91.44 180) (effects (font (size 1.27 1.27)  ) (justify right)) (uuid "a519f6ab-5a29-4b45-a197-00aae28ef192")) (hierarchical_label "IBAT_OUT" (shape output) (at 25.40 96.52 180) (effects (font (size 1.27 1.27)  ) (justify right)) (uuid "709283b3-1812-47f1-86a2-e0a8cde2cb3d")) (hierarchical_label "UBAT_OUT" (shape output) (at 25.40 101.60 180) (effects (font (size 1.27 1.27)  ) (justify right)) (uuid "6f356677-fec8-4be6-9ebc-86eb3d67541a")) (hierarchical_label "UBATT_OUT" (shape output) (at 25.40 106.68 180) (effects (font (size 1.27 1.27)  ) (justify right)) (uuid "e6e35b25-3ce8-4c3a-a89c-911995396fea")) (hierarchical_label "NTC_OUT" (shape output) (at 25.40 111.76 180) (effects (font (size 1.27 1.27)  ) (justify right)) (uuid "ecf9029b-d2ab-4f6d-8bfa-938489404000")) (hierarchical_label "VBAT_RAW" (shape output) (at 25.40 116.84 180) (effects (font (size 1.27 1.27)  ) (justify right)) (uuid "58da5b46-b51c-4654-aef5-3540546a2223")) (text "Выводы листа (иерархические метки) — слева.\nСейчас лист пустой: это структура. Схема — следующим шагом." (exclude_from_sim no) (at 25.40 20.32 0) (effects (font (size 1.27 1.27)  ) (justify left top)) (uuid "a1567043-ba0e-4ef3-b039-8444a54e86b5")) (text "РАЗЪЁМ К СИЛОВОЙ ПЛАТЕ (k57-power, лист \"Разъём к плате управления\")\n\nСписок цепей обязан совпадать с ответным листом на силовой плате.\n\n- Аналоговые сигналы - в парах с GND.\n- VBAT_RAW (до 60 В) - отдельным разъёмом.\n- [?] Тип разъёма - при компоновке." (exclude_from_sim no) (at 106.68 30.48 0) (effects (font (size 1.27 1.27)  ) (justify left top)) (uuid "bdd4e659-7369-4113-98d0-7c43ef825f83")) (embedded_fonts no))