-ab86-2bed3230dd24")) (label "VBAT_RAW" (at 289.56 76.2 180) (fields_autoplaced yes) (effects (font (size 1.27 1.27)) (justify right bottom)) (uuid "ed35871a-3d8c-436f-965d-80fba8ea78e2")) (wire (pts (xy 292.1 78.74) (xy 287.02 78.74)) (stroke (width 0) (type default)) (uuid "080b76f0-d8e2-49a4-b8e5-54d6e795ccb7")) (symbol (lib_id "power:GND") (at 287.02 78.74 0) (unit 1) (exclude_from_sim no) (in_bom yes) (on_board yes) (dnp no) (uuid "eaec9279-34c1-4f25-a277-93b4e59bb5fa") (property "Reference" "#PWR180" (at 287.02000000000004 78.74000000000001 0) (hide yes) (effects (font (size 1.27 1.27)))) (property "Value" "GND" (at 287.02000000000004 82.55 0) (effects (font (size 1.27 1.27)))) (property "Footprint" "" (at 287.02000000000004 78.74000000000001 0) (hide yes) (effects (font (size 1.27 1.27)))) (property "Datasheet" "" (at 287.02000000000004 78.74000000000001 0) (hide yes) (effects (font (size 1.27 1.27)))) (pin "1" (uuid "4a84bacf-7ff1-4dcb-80d6-5738007bd94f")) (instances (project "k57-control" (path "/573ede26-bf47-4e3a-b5d8-48c5571bb05b/ec723b41-6054-4157-8528-c54683eb7855" (reference "#PWR180") (unit 1))))) (text "РАЗЪЁМ К СИЛОВОЙ ПЛАТЕ (k57-power, лист \"Разъём к плате управления\")\nJ501 - ответная часть J601 силовой платы: IDC 2x20, прямой плоский шлейф (контакт 1 - в контакт 1).\n  Распиновка - общая для обеих плат (hardware/tools/k57_links.py), сверяется скриптом check_links.py.\n  1-4 +12V к силовой плате (драйверы, катушка главного контактора), 5-8 и все чётные - GND.\n  9-21 управление: PWM1A/1B/2A/2B, DRV_EN, PRECHARGE_EN, CONTACTOR_EN.\n  23-31 аналоговые сигналы с силовой платы: IA, IBAT, UBAT, UBATT, NTC (RC у входов АЦП - на листе МК).\n  33 +3V3A, 35 VBIAS_1V5, 37 VREF_3V0 - питание и опора измерений силовой платы.\nJ502 - VBAT_RAW (до 60 В) от силовой платы: питание платы управления до контактора.\n  Отдельной клеммой - подальше от сигналов 3,3 В." (exclude_from_sim no) (at 81.28 190.5 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "00b5dc27-a271-4b3b-a8d1-f84c4a1c5bd5")) (embedded_fonts no))