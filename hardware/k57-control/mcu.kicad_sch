5d8-48c5571bb05b/030aac9d-af94-4fe3-b0f8-074ae412a4d6" (reference "#PWR049") (unit 1))))) (wire (pts (xy 477.52 198.12) (xy 480.06 198.12)) (stroke (width 0) (type default)) (uuid "1262ee5f-289f-46ac-81c0-562dfd2d8e45")) (label "SCI_TX" (at 480.06 198.12 0) (fields_autoplaced yes) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "a352e375-9a7f-4f52-a750-39c2afb1d74d")) (symbol (lib_id "Device:R") (at 431.8 215.9 0) (unit 1) (exclude_from_sim no) (in_bom yes) (on_board yes) (dnp yes) (uuid "249540b0-3e42-492b-83d0-855d4113fb11") (property "Reference" "R35" (at 435.61 214.63 0) (effects (font (size 1.27 1.27)) (justify left))) (property "Value" "0" (at 435.61 217.17 0) (effects (font (size 1.27 1.27)) (justify left))) (property "Footprint" "Resistor_SMD:R_0603_1608Metric" (at 431.8 215.9 0) (hide yes) (effects (font (size 1.27 1.27)))) (property "Datasheet" "" (at 431.8 215.9 0) (hide yes) (effects (font (size 1.27 1.27)))) (pin "1" (uuid "9e1b125e-be59-4446-b7cc-ce3d87644e0f")) (pin "2" (uuid "05ee88c8-cb92-4654-a044-e37976bb5d5e")) (instances (project "k57-control" (path "/573ede26-bf47-4e3a-b5d8-48c5571bb05b/030aac9d-af94-4fe3-b0f8-074ae412a4d6" (reference "R35") (unit 1))))) (label "DBG_RST" (at 431.8 212.09 90) (fields_autoplaced yes) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "5db35071-f674-425d-9d6f-5a9e45562143")) (label "XRSn" (at 431.8 219.71 270) (fields_autoplaced yes) (effects (font (size 1.27 1.27)) (justify right bottom)) (uuid "e8313960-5d69-4820-9a1b-1df6f39f95e7")) (text "МИКРОКОНТРОЛЛЕР U1 - TMS320F28P550SJ9, LQFP-100 (PZ)\nРаспределение выводов - docs/k57-mcu-pinout-RU.md. Имена выводов в символе - как в документации TI (SPRSP85D).\nАналоговые входы: 100 Ом + 1 нФ C0G у самого вывода (R11-R18, C11-C18). DACA (A0) -> 100 Ом -> DAC_DBG.\nПитание (SPRSP85D, Pin Attributes): VDDIO - 0,1 мкФ на вывод (C21-C23) + 10 мкФ; VDDA - 2,2 мкФ (C25) + 100 нФ,\n  VDDA от того же 3,3 В через ферритовую бусину FB1 (TI: 3,3-В шины МК - от одного источника);\n  VDD 1,2 В от встроенного регулятора (VREGENZ на землю): все три вывода соединить, 10-22 мкФ - 3 x 4,7 мкФ (C28-C30);\n  VREFHI <- REF2030 3,0 В, 2,2 мкФ к VREFLO (C27). PWR_FLAG на VDD_1V2: её питает встроенный регулятор.\n  Нарастание 3,3 В: не быстрее 100 мВ/мкс (защита от статики). Медленнее 20 мВ/мкс - XRSn может дёрнуться,\n  это безвредно (SPRSP85D, Supply Slew Rate): XRSn у нас не сбрасывает другие микросхемы.\nR36 33 Ом - GPIO8 (74) рядом с PMM: гасит выбросы в минус на линии SPI (SPRSP85D, Table 6-3).\nСброс XRSn: 2,2 кОм к 3,3 В (2,2-10 кОм по документации), 100 нФ (не больше), кнопка SW1.\nКварц 20 МГц Y1, C32/C33 12 пФ под нагрузку 9 пФ [?] - по выбранному кварцу.\nЗагрузка: GPIO24 и GPIO32 подтянуты к 3,3 В (запуск из флеша). JP1 замкнуть - режим ожидания SCI.\nОтладка J1 (2x7, 1,27 мм) - разводка как у J102 LaunchPad: 2 TMS, 4 TCK, 12 XDS_TXD -> SCI_RX (GPIO35),\n  14 XDS_RXD <- SCI_TX (GPIO37), 3/5/9/11/13 GND. Вывод 1 - это +3,3 В самого отладчика: НЕ подключать.\n  6/8 (TDO/TDI) в режиме cJTAG не нужны. 10 - сброс от отладчика: через R35 (не запаивать).\n  TMS - подтяжка 2,2 кОм (вывода TRSTn нет). Консоль UART идёт по тому же кабелю.\nСвободные выводы помечены \"не подключено\". GPIO14/15/22/23 в SysConfig отданы EPWM3/EPWM4 [?]." (exclude_from_sim no) (at 83.82 355.6 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "5d32aca5-21fc-4b8b-b08a-6c0569b47f8c")) (embedded_fonts no))