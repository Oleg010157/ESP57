(kicad_sch (version 20250610) (generator "eeschema") (generator_version "10.0") (uuid "28074b83-6a23-4e53-8770-00fce375f695") (paper "A4") (title_block (title "K57 плата управления: Разъём к плате 230 В") (date "2026-11-24") (rev "0.1 структура") (comment 1 "МК, питание, приёмники 230 В, интерфейсы") (comment 2 "Техзадание: docs/k57-power-stage-spec-RU.md")) (lib_symbols) (hierarchical_label "GRID_CONT_EN" (shape input) (at 25.40 30.48 180) (effects (font (size 1.27 1.27)  ) (justify right)) (uuid "bcbfa348-d708-4bbd-8b19-8715a2234460")) (hierarchical_label "+12V" (shape passive) (at 25.40 35.56 180) (effects (font (size 1.27 1.27)  ) (justify right)) (uuid "8651ffe1-1a9b-48a1-bac8-a609d02846a6")) (hierarchical_label "+3V3A" (shape passive) (at 25.40 40.64 180) (effects (font (size 1.27 1.27)  ) (justify right)) (uuid "d06de553-b58b-4b8a-a8e1-a8174c9e59c8")) (hierarchical_label "GND" (shape passive) (at 25.40 45.72 180) (effects (font (size 1.27 1.27)  ) (justify right)) (uuid "f6b5ab48-c4b9-49aa-8229-266a7ed488ca")) (hierarchical_label "IB_P" (shape output) (at 25.40 50.80 180) (effects (font (size 1.27 1.27)  ) (justify right)) (uuid "9f845e33-92ec-4962-aba1-da3f4408be75")) (hierarchical_label "IB_N" (shape output) (at 25.40 55.88 180) (effects (font (size 1.27 1.27)  ) (justify right)) (uuid "eebbe417-ddbd-4ba6-b662-73310186a49f")) (hierarchical_label "U220_P" (shape output) (at 25.40 60.96 180) (effects (font (size 1.27 1.27)  ) (justify right)) (uuid "626fde65-2881-4e0b-b0b8-04623ff7b23b")) (hierarchical_label "U220_N" (shape output) (at 25.40 66.04 180) (effects (font (size 1.27 1.27)  ) (justify right)) (uuid "892bf424-e836-4891-9779-f1563743cbf9")) (hierarchical_label "USEC_P" (shape output) (at 25.40 71.12 180) (effects (font (size 1.27 1.27)  ) (justify right)) (uuid "75dd8fa9-9b3f-49cb-84e8-f8f7b704cdb7")) (hierarchical_label "USEC_N" (shape output) (at 25.40 76.20 180) (effects (font (size 1.27 1.27)  ) (justify right)) (uuid "784f3c24-db05-43d4-96e9-e92a50aee369")) (text "Выводы листа (иерархические метки) — слева.\nСейчас лист пустой: это структура. Схема — следующим шагом." (exclude_from_sim no) (at 25.40 20.32 0) (effects (font (size 1.27 1.27)  ) (justify left top)) (uuid "68d49dc4-c5e5-4d7b-86ad-ccfd12a32399")) (text "РАЗЪЁМ К ПЛАТЕ 230 В (k57-ac, лист \"Разъём к плате управления\")\n\nСписок цепей обязан совпадать с ответным листом на k57-ac.\nВсе цепи этого разъёма - низковольтные: 230 В на k57-ac остаётся за\nизоляционным барьером (AMC3330, трансформатор тока).\n\n- Дифференциальные пары - соседними выводами, лучше витыми парами.\n- [?] Тип разъёма - при компоновке." (exclude_from_sim no) (at 106.68 30.48 0) (effects (font (size 1.27 1.27)  ) (justify left top)) (uuid "37e995a0-20a8-41c6-9e11-73888ee69cbe")) (embedded_fonts no))