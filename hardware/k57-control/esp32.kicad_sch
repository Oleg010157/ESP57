ts (font (size 1.27 1.27)) (justify right bottom)) (uuid "30c5e588-a557-4bf2-a5a3-c6d9b84d625a")) (wire (pts (xy 304.8 175.26) (xy 307.34 175.26)) (stroke (width 0) (type default)) (uuid "916924f6-cf40-42a7-a1e3-991e844c1429")) (label "USB_DN" (at 307.34 175.26 0) (fields_autoplaced yes) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "288e7fea-eb80-4429-8e45-21f758a5a3c6")) (symbol (lib_id "power:GND") (at 299.72 180.34 0) (unit 1) (exclude_from_sim no) (in_bom yes) (on_board yes) (dnp no) (uuid "30fa7907-c701-4499-b231-02b25f8b7398") (property "Reference" "#PWR143" (at 299.72 180.34 0) (hide yes) (effects (font (size 1.27 1.27)))) (property "Value" "GND" (at 299.72 184.15 0) (effects (font (size 1.27 1.27)))) (property "Footprint" "" (at 299.72 180.34 0) (hide yes) (effects (font (size 1.27 1.27)))) (property "Datasheet" "" (at 299.72 180.34 0) (hide yes) (effects (font (size 1.27 1.27)))) (pin "1" (uuid "15fa11d2-5f1c-4b2e-9d1c-a5b0b8ad7539")) (instances (project "k57-control" (path "/573ede26-bf47-4e3a-b5d8-48c5571bb05b/c85387c6-8201-4f3e-b3d3-9e19ae302a08" (reference "#PWR143") (unit 1))))) (symbol (lib_id "power:+5V") (at 299.72 167.64 0) (unit 1) (exclude_from_sim no) (in_bom yes) (on_board yes) (dnp no) (uuid "45833495-9d59-4f6c-8965-14d4e79f89b1") (property "Reference" "#PWR144" (at 299.72 167.64 0) (hide yes) (effects (font (size 1.27 1.27)))) (property "Value" "+5V" (at 299.72 163.83 0) (effects (font (size 1.27 1.27)))) (property "Footprint" "" (at 299.72 167.64 0) (hide yes) (effects (font (size 1.27 1.27)))) (property "Datasheet" "" (at 299.72 167.64 0) (hide yes) (effects (font (size 1.27 1.27)))) (pin "1" (uuid "25ca8b3c-68ca-4177-99ce-f628b32dbc78")) (instances (project "k57-control" (path "/573ede26-bf47-4e3a-b5d8-48c5571bb05b/c85387c6-8201-4f3e-b3d3-9e19ae302a08" (reference "#PWR144") (unit 1))))) (text "ESP32-S3 - МОСТ SPI <-> WiFi (техзадание 6.7.2)\nU302 ESP32-S3-WROOM-1-N8 (антенна на модуле). [?] -1U с разъёмом, если корпус металлический.\nВедомый SPI2 на выводах IOMUX: CS GPIO10, MOSI GPIO11, CLK GPIO12, MISO GPIO13 (через R304 33 Ом).\n  \"Есть данные\" (ESP_RDY, активный низкий) - GPIO14. R303 держит CS в 1, пока F28 стартует.\nU301 TLV75733P - свой 3,3 В от +5V: всплески тока радио не идут в питание МК. C302 22 мкФ + C304/C305 у модуля.\nEN: R301 10 кОм + C306 1 мкФ (задержка запуска), кнопка SW301. BOOT: GPIO0, кнопка SW302 (держать при сбросе -\n  режим прошивки). Выводы выбора режима GPIO3, GPIO45, GPIO46 не подключены: остаются по умолчанию.\nJ301 USB-C: родной USB ESP32-S3 (GPIO19/GPIO20) - прошивка и консоль без преобразователя USB-UART.\n  CC1/CC2 - 5,1 кОм на землю (устройство). U303 - защита от статики. VBUS не подключён: плату питать\n  от своего источника. Земля USB = земля управления = минус АКБ: только для сервиса [?] USB-изолятор.\nАнтенна - на краю платы, под ней и рядом без меди на всех слоях (зона по документации модуля).\nПрошивка моста: цель esp32s3, SPI2_HOST, выводы - в ESP32_BRIDGE/main/board.h (техзадание, раздел 7)." (exclude_from_sim no) (at 63.5 218.44 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "3e080f19-af60-4a87-9201-7ca51b4b19c4")) (embedded_fonts no))