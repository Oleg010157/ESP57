+/*
+ * myLED.h
+ *
+ *  Created on: 30.10.2026
+ *      Author: Oleg Pavlovsky
+ */
+
+#ifndef MYLED_H_
+#define MYLED_H_
+
+#include <stdint.h>
+
+// Бегущий огонёк по LED1..LED11 платы PCB_MCU-F2803. Зовётся из фона раз в
+// 50 мс. Разбор - в myLED.c.
+extern volatile uint16_t dbgLedWave;
+
+void LED_waveBackground(void);
+
+#endif /* MYLED_H_ */
