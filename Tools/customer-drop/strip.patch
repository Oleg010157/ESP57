diff --git a/INVERTOR_CCS/my_Files/myLED.c b/INVERTOR_CCS/my_Files/myLED.c
new file mode 100644
index 0000000..8f7f285
--- /dev/null
+++ b/INVERTOR_CCS/my_Files/myLED.c
@@ -0,0 +1,103 @@
+/*
+ * myLED.c
+ *
+ *  Created on: 30.10.2026
+ *      Author: Oleg Pavlovsky
+ */
+
+#include "driverlib.h"
+#include "device.h"
+#include "f28p55x_device.h"
+#include "myLED.h"
+
+//
+// Бегущий огонёк по светодиодам платы PCB_MCU-F2803: видно, что плата ожила и
+// фоновый цикл крутится. Команда - из окна Watch:
+//
+//   dbgLedWave = 0 - выключено, выводы не трогаются;
+//   dbgLedWave = 1 - бежит огонёк, по dbgLedStep тиков на светодиод
+//                    (по умолчанию: огонёк бежит сразу после сброса).
+//
+// Светодиоды висят анодом на 3-5V_MCU через 330 Ом, катодом на LD1..LD6 и
+// COL1..COL6, а те - на выходах инверторов 74HC04. Поэтому светодиод горит при
+// ЕДИНИЦЕ на GPIO. Питание 3-5V_MCU выбирается перемычкой: без него не горит
+// ничего.
+//
+// COL4 и COL5 приходят через перемычки H8-H9 (GPIO59, GPIO44). Нет перемычек -
+// эти два не горят.
+//
+// LED12 (COL6) НЕ УЧАСТВУЕТ: он на GPIO7, а это EPWM4B, затвор ключа на силовой
+// плате. Этот вывод здесь не трогается.
+//
+// GPIO57 (COL2) - он же отладочная ножка, её дёргает INT_myEPWM6_ISR на каждом
+// такте. Пока бежит огонёк, прерывание её не трогает, иначе COL2 горел бы
+// вполнакала всё время.
+//
+// Шаг - тики фона по 50 мс (блок CpuTimer0 в main.c), по умолчанию 20 = 1 с.
+//
+volatile uint16_t dbgLedWave = 1;
+volatile uint16_t dbgLedStep = 20; // тиков по 50 мс на один светодиод
+volatile uint16_t dbgLedNow  = 0;  // какой горит сейчас, 1..11; 0 - никакой
+
+#define LED_COUNT 11U
+
+// Порядок - как на схеме: LED1..LED6 на LD1..LD6, LED7..LED11 на COL1..COL5.
+static const uint16_t ledPin[LED_COUNT] =
+{
+    48U, 47U, 49U, 50U, 51U, 52U, // LD1..LD6
+    56U, 57U, 58U,                // COL1..COL3
+    59U, 44U                      // COL4..COL5, через перемычки H8-H9
+};
+
+static const uint32_t ledPinConfig[LED_COUNT] =
+{
+    GPIO_48_GPIO48, GPIO_47_GPIO47, GPIO_49_GPIO49,
+    GPIO_50_GPIO50, GPIO_51_GPIO51, GPIO_52_GPIO52,
+    GPIO_56_GPIO56, GPIO_57_GPIO57, GPIO_58_GPIO58,
+    GPIO_59_GPIO59, GPIO_44_GPIO44
+};
+
+void LED_waveBackground(void)
+{
+    static uint16_t mode = 0; // в каком режиме выводы сейчас
+    static uint16_t tick = 0;
+    uint16_t i;
+
+    if (dbgLedWave != mode)
+    {
+        mode = dbgLedWave;
+        tick = 0;
+        dbgLedNow = 0;
+
+        if (mode == 0)
+        {
+            for (i = 0; i < LED_COUNT; i++)
+                GPIO_writePin(ledPin[i], 0);
+            return;
+        }
+
+        // Сначала уровень, потом направление: вывод выходит сразу в нуле,
+        // то есть светодиод погашен.
+        for (i = 0; i < LED_COUNT; i++)
+        {
+            GPIO_writePin(ledPin[i], 0);
+            GPIO_setPinConfig(ledPinConfig[i]);
+            GPIO_setDirectionMode(ledPin[i], GPIO_DIR_MODE_OUT);
+        }
+    }
+
+    if (mode == 0)
+        return;
+
+    if (tick != 0U)
+    {
+        tick--;
+        return;
+    }
+    tick = (dbgLedStep != 0U) ? dbgLedStep - 1U : 0U;
+
+    if (dbgLedNow != 0U)
+        GPIO_writePin(ledPin[dbgLedNow - 1U], 0);
+    dbgLedNow = (dbgLedNow >= LED_COUNT) ? 1U : dbgLedNow + 1U;
+    GPIO_writePin(ledPin[dbgLedNow - 1U], 1);
+}
