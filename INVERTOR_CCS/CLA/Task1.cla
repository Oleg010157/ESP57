#include "f28p55x_device.h"

#include "myADC.h"

#include "cla.h"
#include "cla_shared.h"
#include "Task1_alias.h"

#include "CLAmath.h"




volatile uint16_t dbgtest;
volatile uint16_t task1Time;

#pragma CODE_SECTION(Cla1Task1, "Cla1Prog");
__interrupt void Cla1Task1(void)
{
    dbgtest = EPwm7Regs.TBCTR;

    Udc_kod  = (int16_t)AdcaResultRegs.ADCPPB1RESULT.bit.PPBRESULT;
   

#if dbgUdc
    Udc_volt = Udc_imit;
#else
    Udc_volt = kadcf.Udc * Udc_kod;
#endif

    Udc_rf = 0.9f * Udc_rf + 0.1f * Udc_volt;

    Idc_kod = (int16_t)AdcaResultRegs.ADCPPB3RESULT.bit.PPBRESULT;
    Idc_amp = kadcf.Idc * Idc_kod;
    Idc_rf  = 0.9f * Idc_rf + 0.1f * Idc_amp;

    Vin_kod  = (int16_t)AdcaResultRegs.ADCPPB2RESULT.bit.PPBRESULT;
    Vin_volt = kadcf.Vin * Vin_kod;
    Vin_rf   = Vin_rf * 0.9f + Vin_volt * 0.1f;

    if (c.State == STATE_PRECHARGE)
    {
        c.prechargeTicks++;

        if (Idc_amp < Idc_max)
        {
            c.dutyControl += 0.0005f;
            if (c.dutyControl > 0.3f)
                c.dutyControl = 0.3f;
        }
        else
        {
            c.dutyControl -= 0.001f;
            if (c.dutyControl < 0.05f)
                c.dutyControl = 0.05f;
        }

        if ((Udc_volt > 550.0f) || (c.prechargeTicks > c.prechargeLimit))
        {
            c.State = STATE_RUN;
        }
    }
    else 
    {
        c.dutyControl = PI_update(&pi, Udc_ref, Udc_volt);
    }

    c.duty = 0.5f - c.dutyControl * 0.4f;
    c.CMPA = (uint16_t)(EPwm1Regs.TBPRD * c.duty);

    EPwm1Regs.CMPA.bit.CMPA = c.CMPA;

    task1Time = (EPwm7Regs.TBCTR - dbgtest); // время в 1/120 мкс
}

