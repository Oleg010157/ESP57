//---------------------------------------------------------------------------
// Cla1Task1 - измерительная задача CLA.
//
// Запускается аппаратно по ADCA INT2, которая взведена на EOC3 - конец
// ПОСЛЕДНЕГО из шести преобразований (SysConfig: myADCA.interrupt2SOCSource =
// EOC3, myCLA0.trigger_CLA_TASK_1 = CLA_TRIGGER_ADCA2). Так задача заведомо
// видит готовые результаты всех каналов, а не половину.
//
// Прерывание CPU по завершению задачи не заводится (cpuint_CLA_TASK_1 = false):
// результат читают из фона и по отладчику.
//
// ЧТО СЧИТАЕТ.
//
//   Мгновенные значения трёх каналов - iBat, uBat, uSec. Остальные три (iPri,
//   iSec, u220) считает CPU, и отдавать их сюда нельзя: их потребляет контур
//   тока в INT_myADCB_1_ISR по EOC1, то есть на ~2.3 мкс РАНЬШЕ, чем
//   отработает эта задача.
//
//   Действующие значения ВСЕХ ЧЕТЫРЁХ величин, у которых они имеют смысл -
//   iPri_rms, iSec_rms, u220_rms, uSec_rms. Здесь запаздывание безразлично,
//   поэтому считать их на CPU было незачем.
//
//   Мощности на выходе инвертора - активную, реактивную, полную и коэффициент
//   мощности. Тем же окном и по тем же причинам: работа набегает каждый такт,
//   а нужна раз за период сети.
//
// Полный список величин и разбор, кто что пишет, - в cla_shared.c.
//
// ЧЕГО ЗДЕСЬ БОЛЬШЕ НЕТ. Прежняя редакция вела машину состояний precharge,
// считала PI по Udc_ref и писала результат в EPwm1Regs.CMPA. Для K57 это было
// неприменимо целиком:
//
//   - EPWM1 в K57 - плечо A моста инвертора (GPIO0/GPIO1). Ту же CMPA каждый
//     такт пишет sine_invertor2() / grid_tie_step() из прерывания ADCB. CLA
//     работает асинхронно к CPU, так что выходила гонка на регистре,
//     управляющем реальными ключами;
//   - ШИМ для DC/DC в проекте нет вообще: выходные пины назначены только у
//     EPWM1 и EPWM2, ключи vt1..vt4 фигурируют лишь в разборе аварий по TRIP4;
//   - "Udc" брался с ADCA PPB1, а PPB1 в K57 - это канал сети 220 В (A0).
//     Раскладка досталась от старого проекта, как и сами имена Udc/Idc/Vin:
//     каналы K57 зовутся iPri, iSec, iBat, u220, uBat, uSec (см. ADCpar в
//     myADC.h), отдельного звена постоянного тока среди них нет - на входе
//     моста стоит АКБ, канал uBat.
//
// Вернуть контур DC/DC можно будет, когда у преобразователя появятся свой ШИМ
// и канал измерения. PI_update() и slewLimit() для этого оставлены в
// cla_task1.h.
//---------------------------------------------------------------------------

#include "f28p55x_device.h"

#include "myADC.h"

#include "cla.h"
#include "cla_shared.h"

// CLAsqrt_inline. Заголовок самодостаточен - функция объявлена static inline
// с FUNC_ALWAYS_INLINE, библиотеку линковать не нужно. Заодно перекрывает
// sqrtf и __divf32 своими быстрыми версиями на MEINVF32/MEISQRTF32.
#include "CLAmath.h"

// task1Start / task1Time (длительность задачи в тактах EPWM7) объявлены в
// cla_shared.c и лежат в Cla1ToCpuMsgRAM - выделенном блоке для направления
// CLA -> CPU.
//
// Накопители сумм квадратов и счётчик окна остаются здесь: это внутреннее
// состояние задачи, а не результат, наружу отдавать нечего. Не static - пусть
// будут видны отладчику. Лежат в .bss_cla, то есть в RAMLS2, той же памяти,
// что отдана CLA под данные.
volatile float    iPri_sum2;
volatile float    iSec_sum2;
volatile float    u220_sum2;
volatile float    uSec_sum2;
volatile uint16_t rmsCnt;

// Накопители мощности и кольцо задержки тока на четверть периода - см. разбор
// перед их применением ниже.
//
// Длина кольца выбрана по ПОТОЛКУ числа точек синусоиды: sineB.resolution
// задаётся командой 621 в пределах 10..256 (CanTxFiles/sineB.ini), четверть
// от 256 - это 64, плюс одна ячейка под текущий отсчёт. Меньше нельзя: кольцо
// короче задержки означало бы, что читаем мы не тот отсчёт, о котором думаем,
// и реактивная мощность тихо станет неправильной.
#define QBUF_LEN 65U

volatile float    pSec_sum;
volatile float    qSec_sum;
volatile float    qBuf[QBUF_LEN];
volatile uint16_t qIdx;

#pragma CODE_SECTION(Cla1Task1, "Cla1Prog");
__interrupt void Cla1Task1(void)
{
    task1Start = EPwm7Regs.TBCTR;

    // Три канала с АЦП - но только если модель силовой части выключена.
    //
    // На модели (simOn = 1) те же три величины пишет plant_sim_step() на CPU,
    // в прерывании ADCB по EOC1. Мы идём по EOC3, то есть ПОЗЖЕ, и без этого
    // ключа каждый такт затирали бы модель отсчётами ног, к которым на стенде
    // ничего не подключено. Разбор - my_Files/plant_sim.txt.
    //
    // Сглаживающие фильтры и суммы для RMS стоят ВНЕ ключа: им безразлично,
    // кто положил мгновенное значение, и на модели они обязаны работать так же.
    if (!simOn)
    {
        // Ток АКБ. A12, SOC2/PPB3.
        // Знаковый результат PPB - уже за вычетом откалиброванного нуля канала.
        iBat_kod = (int16_t)AdcaResultRegs.ADCPPB3RESULT.bit.PPBRESULT;
        iBat_amp = kadcf.iBat * iBat_kod;

        // Напряжение АКБ, оно же напряжение звена на входе моста. A4, SOC1/PPB2.
        uBat_kod  = (int16_t)AdcaResultRegs.ADCPPB2RESULT.bit.PPBRESULT;
        uBat_volt = kadcf.uBat * uBat_kod;

        // Напряжение на выходе инвертора, до контактора. A1, SOC3/PPB4.
        // Именно окончание этого преобразования и взводит задачу.
        uSec_kod  = (int16_t)AdcaResultRegs.ADCPPB4RESULT.bit.PPBRESULT;
        uSec_volt = kadcf.uSec * uSec_kod;
    }

    iBat_rf = 0.9f * iBat_rf + 0.1f * iBat_amp;
    uBat_rf = 0.9f * uBat_rf + 0.1f * uBat_volt;

    //-----------------------------------------------------------------------
    // Действующие значения. Раньше это считал CPU в прерывании контура тока
    // (adc_rms_update в 1ph_Sin.c), теперь здесь - четыре умножения с
    // накоплением каждый такт и четыре корня раз за период сети.
    //
    // Слагаемые все ЭТОГО такта, задача идёт последней:
    //   u220_volt          - CPU, прерывание ADCA по EOC0 (~1.2 мкс);
    //   iPri_amp, iSec_amp - CPU, прерывание ADCB по EOC1 (~2.3 мкс);
    //   uSec_volt          - строкой выше;
    //   мы сами            - EOC3 (~4.6 мкс).
    // Даже если прерывание ADCB чем-то задержится и токи окажутся прошлого
    // такта, на RMS это не влияет: запаздывание одинаково для всех отсчётов
    // окна, а сумма квадратов за целый период от сдвига по фазе не зависит.
    //
    // Окно - rmsWindow отсчётов, копия sineB.resolution (её кладёт
    // change_sine(), см. cla_shared.c). Оно обязано быть ЦЕЛЫМ ЧИСЛОМ
    // ПЕРИОДОВ сети: АЦП запускается от EPWM1_SOCA, период EPWM1 подстроен
    // PLL так, что на период сети приходится ровно resolution отсчётов.
    // Незамкнутый хвост периода попал бы в сумму целиком, и результат стал бы
    // зависеть от фазы обрыва окна - та же ловушка, что разобрана в
    // Adc_Calibrate() (myADC.c).
    //-----------------------------------------------------------------------
    iPri_sum2 += iPri_amp * iPri_amp;
    iSec_sum2 += iSec_amp * iSec_amp;
    u220_sum2 += u220_volt * u220_volt;
    uSec_sum2 += uSec_volt * uSec_volt;

    //-----------------------------------------------------------------------
    // Мощности на выходе инвертора - пара uSec и iSec.
    //
    // АКТИВНАЯ есть среднее мгновенной мощности за период, и никакого другого
    // определения у неё нет: ни форма тока, ни гармоники на это не влияют.
    // Одно умножение с накоплением.
    //
    // РЕАКТИВНАЯ определена только для основной гармоники, и считается она
    // тем же произведением, но с током, ЗАДЕРЖАННЫМ НА ЧЕТВЕРТЬ ПЕРИОДА.
    // Сдвиг на 90 градусов для синусоиды - это и есть преобразование
    // Гильберта, а четверть периода у нас лежит ровно в rmsWindow/4 отсчётах:
    // на период сети приходится rmsWindow тактов, за этим следит PLL.
    //
    // Откуда минус. Пусть u = U sin(wt), i = I sin(wt - f). Тогда
    //     i(t - T/4) = I sin(wt - pi/2 - f)
    //     <u * i(t-T/4)> = (U*I/2) * cos(pi/2 + f) = -(U*I/2) sin f = -Q
    // то есть накопитель даёт Q с обратным знаком, и вычитание здесь - не
    // опечатка. При индуктивной нагрузке (f > 0) qSec выходит положительной.
    //
    // ПОЛНАЯ берётся произведением действующих, ниже по окну. Учтите: при
    // искажённом токе S^2 НЕ равно P^2 + Q^2 - разницу даёт мощность
    // искажений, и это не ошибка расчёта, а её определение.
    //-----------------------------------------------------------------------
    pSec_sum += uSec_volt * iSec_amp;

    {
        uint16_t d = rmsWindow >> 2;
        uint16_t j;

        if (d >= QBUF_LEN)
            d = QBUF_LEN - 1U;

        j = (qIdx >= d) ? (uint16_t)(qIdx - d) : (uint16_t)(qIdx + QBUF_LEN - d);

        // Читаем задержанный отсчёт ДО записи текущего: при d = 0 обе операции
        // смотрели бы в одну ячейку. Такое d недостижимо (минимум resolution -
        // 10 точек, четверть от них 2), но порядок всё равно правильный.
        qSec_sum -= uSec_volt * qBuf[j];

        qBuf[qIdx] = iSec_amp;

        if (++qIdx >= QBUF_LEN)
            qIdx = 0U;
    }

    if ((++rmsCnt >= rmsWindow) && (rmsCnt > 0))
    {
        // Делим на фактический счётчик, а не на rmsWindow: если окно сменят
        // командой посреди набора, деление всё равно останется верным.
        float n = (float)rmsCnt;

        iPri_rms = CLAsqrt_inline(iPri_sum2 / n);
        iSec_rms = CLAsqrt_inline(iSec_sum2 / n);
        u220_rms = CLAsqrt_inline(u220_sum2 / n);
        uSec_rms = CLAsqrt_inline(uSec_sum2 / n);

        // Мощности. Полная считается ПОСЛЕ действующих - по ним же.
        pSec = pSec_sum / n;
        qSec = qSec_sum / n;
        sSec = uSec_rms * iSec_rms;

        // Порог на делении - не защита от нуля, а защита от мусора: при
        // обесточенном мосте и S, и P лежат в шумах, и их частное скакало бы
        // между -1 и +1 на глазах у оператора. 1 В*А для 3 кВт - ничто.
        pfSec = (sSec > 1.0f) ? (pSec / sSec) : 0.0f;

        iPri_sum2 = 0.0f;
        iSec_sum2 = 0.0f;
        u220_sum2 = 0.0f;
        uSec_sum2 = 0.0f;
        pSec_sum  = 0.0f;
        qSec_sum  = 0.0f;
        rmsCnt    = 0;
    }

    task1Time = (EPwm7Regs.TBCTR - task1Start);
}
