#include "f28p55x_device.h"

#include "myADC.h"

#include "cla.h"
#include "cla_shared.h"

#include "CLAmath.h"




volatile uint16_t dbgtest;
volatile uint16_t task1Time;

#pragma CODE_SECTION(Cla1Task1, "Cla1Prog");
__interrupt void Cla1Task1(void)
{
    dbgtest = EPwm7Regs.TBCTR;

    dc.Udc_kod  = (int16_t)AdcaResultRegs.ADCPPB1RESULT.bit.PPBRESULT;


#if dbgUdc
    dc.Udc_volt = Udc_imit;
#else
    dc.Udc_volt = kadcf.u220 * dc.Udc_kod;
#endif

    dc.Udc_rf = 0.9f * dc.Udc_rf + 0.1f * dc.Udc_volt;

    dc.Idc_kod = (int16_t)AdcaResultRegs.ADCPPB3RESULT.bit.PPBRESULT;
    dc.Idc_amp = kadcf.iBat * dc.Idc_kod;
    dc.Idc_rf  = 0.9f * dc.Idc_rf + 0.1f * dc.Idc_amp;

    dc.Vin_kod  = (int16_t)AdcaResultRegs.ADCPPB2RESULT.bit.PPBRESULT;
    dc.Vin_volt = kadcf.uBat * dc.Vin_kod;
    dc.Vin_rf   = dc.Vin_rf * 0.9f + dc.Vin_volt * 0.1f;

    if (dctl.State == STATE_PRECHARGE)
    {
        dctl.prechargeTicks++;

        if (dc.Idc_amp < dc.Idc_max)
        {
            dctl.dutyControl += 0.0005f;
            if (dctl.dutyControl > 0.3f)
                dctl.dutyControl = 0.3f;
        }
        else
        {
            dctl.dutyControl -= 0.001f;
            if (dctl.dutyControl < 0.05f)
                dctl.dutyControl = 0.05f;
        }

        if ((dc.Udc_volt > 550.0f) || (dctl.prechargeTicks > dctl.prechargeLimit))
        {
            dctl.State = STATE_RUN;
        }
    }
    else
    {
        dctl.dutyControl = PI_update(&pi, dc.Udc_ref, dc.Udc_volt);
    }

    dctl.duty = 0.5f - dctl.dutyControl * 0.4f;
    dctl.CMPA = (uint16_t)(EPwm1Regs.TBPRD * dctl.duty);

    EPwm1Regs.CMPA.bit.CMPA = dctl.CMPA;

    task1Time = (EPwm7Regs.TBCTR - dbgtest); // время в 1/150 мкс
}

