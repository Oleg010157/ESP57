#include "f28p55x_device.h"

#include "myADC.h"

#include "cla.h"
#include "cla_shared.h"
#include "CLAmath.h"
#include "Konstanty.h"


#define SQ(sum,count)  CLAsqrt_inline( CLAdiv_inline(sum, count)) // корень из суммы квадратов

float cla_sqrt(float x)
{
    uint16_t i;
    if (x <= 0.0f)
        return 0.0f;
    float guess = x / 2.0f;
    for (i = 0; i < 5; i++)
    {
        guess = (guess + x / guess) * 0.5f;
    }
    return guess;
}


#define p (cla)


volatile uint16_t dbgCLA7, task7Time;
volatile float dbgI0,dbgI1;
#pragma CODE_SECTION(Cla1Task7, "Cla1Prog");
__interrupt void Cla1Task7(void)
{
   

   c2p.Ia_kod = (int16_t)AdcbResultRegs.ADCPPB1RESULT.bit.PPBRESULT;
   c2p.Ib_kod = (int16_t)AdcbResultRegs.ADCPPB2RESULT.bit.PPBRESULT;
   c2p.Ic_kod = -c2p.Ia_kod - c2p.Ib_kod;

 //  if (cla.error == 0) //защёлка значений тока в момент срабатывания защиты
   {
       c2p.Ia_amp = kadcf.iPri * c2p.Ia_kod;
       c2p.Ib_amp = kadcf.iSec * c2p.Ib_kod;
       c2p.Ic_amp = -c2p.Ia_amp - c2p.Ib_amp;
   }
       
    cla.Ia_rf = cla.Ia_rf * 0.9f + c2p.Ia_amp * 0.1f;
    cla.Ib_rf = cla.Ib_rf * 0.9f + c2p.Ib_amp * 0.1f;
    cla.Ic_rf = cla.Ic_rf * 0.9f + c2p.Ic_amp * 0.1f;

    
    // мощности
    p.Pa = c2p.Ia_amp * c2p.Va_volt;
    p.Pb = c2p.Ib_amp * c2p.Vb_volt;
    p.Pc = c2p.Ic_amp * c2p.Vc_volt;

    p.Pabc    = p.Pa + p.Pb + p.Pc;
    p.Pabc_rf = p.Pabc_rf * 0.99f + p.Pabc * 0.01f;

    // RMS фазных токов через рекурентный фильтр
    cs.Iaaf = cs.Iaaf * 0.997f + c2p.Ia_amp * c2p.Ia_amp * 0.003f;
    cs.Ibbf = cs.Ibbf * 0.997f + c2p.Ib_amp * c2p.Ib_amp * 0.003f;
    cs.Iccf = cs.Iccf * 0.997f + c2p.Ic_amp * c2p.Ic_amp * 0.003f;

    p.Ia_rms = CLAsqrt_inline(cs.Iaaf);
    p.Ib_rms = CLAsqrt_inline(cs.Ibbf);
    p.Ic_rms = CLAsqrt_inline(cs.Iccf);


   // RMS2 - дополнтиельный метод вычисления средних и rms значений по выборке измерений за период синусоиды модулированного сигнала
   
    // накопление сумм квадратов
    cs.Ia_sum += c2p.Ia_amp * c2p.Ia_amp;
    cs.Ib_sum += c2p.Ib_amp * c2p.Ib_amp;
    cs.Ic_sum += c2p.Ic_amp * c2p.Ic_amp;
    cs.Va_sum += c2p.Va_volt * c2p.Va_volt;
    
    cs.sPu += p.Pa;
    cs.sPabc += p.Pabc;

    p.count++;
    // Вычисляем среднии и rms значения  по выборке измерений.
    // Выборка определяется как константное число samples плюс дополнительно
    // несколько измерений  до момента завершения периода частоты поля, определяет
    // установленный flag Если поле стоит и соответсвенно  flag не меняется
    // суммирование проводим по выборке двойного размера

  if ((p.count >= 100) && (p.flag == 1) || (p.count >= (10000)))
  
    {
        // токи
dbgCLA7    = EPwm7Regs.TBCTR;
      //  p.Ia_rms = sqrtf(Ia_sum / p.count);
      //  p.Ia_rms = __sqrtf( CLAdiv_inline32(Ia_sum, p.count));
         rms.Ia = SQ(cs.Ia_sum, p.count);
        cs.Ia_sum = 0;
 
     // p.Ib_rms = sqrtf( ivf32(Ib_sum / p.count));
         rms.Ib = SQ(cs.Ib_sum, p.count);
        cs.Ib_sum = 0;

        rms.Ic = sqrtf(cs.Ic_sum / p.count);
     //   p.Ic_rms = SQ(Ic_sum, p.count);
        cs.Ic_sum = 0;

     //   p.Va_rms = sqrtf(Va_sum / p.count);
        rms.Va = SQ(cs.Va_sum, p.count);
        cs.Va_sum = 0;

     //   p.Udc_rms = sqrtf(Udc_sum / p.count);
        rms.Udc = SQ(cs.Udc_sum, p.count);
        cs.Udc_sum = 0;

     //   p.Pa = sPu * 3 / p.count;
        p.Pa =  CLAdiv_inline(cs.sPu * 3, p.count);
        cs.sPu = 0;

      //  p.mPabc = sPabc / p.count;
        p.mPabc =  CLAdiv_inline(cs.sPabc, p.count);
        cs.sPabc = 0;

     //   p.mPaz = spaz / p.count;
        p.mPaz = CLAdiv_inline(cs.spaz, p.count);
        cs.spaz = 0;

        // мощности через Pa
        p.mSabc = (p.Ia_rms + p.Ib_rms + p.Ic_rms) * p.Va_rms;
        p.mPF = CLAdiv_inline(p.mPabc, p.mSabc);

        p.mPx = CLAsqrt_inline((p.mSabc * p.mSabc) - (p.mPabc * p.mPabc));
        if (p.mSabc > 1)
            (p.cosPhi = CLAdiv_inline(p.Pa, p.mSabc));

     //   p.Pain = Pain_sum / p.count;
        p.Pain = CLAdiv_inline(cs.Pain_sum, p.count);
        
        cs.Pain_sum = 0;

        p.count = 0;
         task7Time = (EPwm7Regs.TBCTR - dbgCLA7);
    }
         p.flag = 0;

        
        
}
