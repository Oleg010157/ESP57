analog1.analog["a11/b10/c0Pin"].$suggestSolution          = "A11/B10/C0";
analog1.analog["a12, c1Pin"].$suggestSolution             = "A12, C1";
analog1.analog["a15, c7/b9Pin"].$suggestSolution          = "A15, C7/B9";
analog1.analog["a4/b8, c14Pin"].$suggestSolution          = "A4/B8, C14";
