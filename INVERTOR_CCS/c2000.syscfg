const spi            = scripting.addModule("/driverlib/spi.js", {}, false);
const spi1           = spi.addInstance();

/**
 * Write custom configuration values to the imported modules.
 */
adc1.$name                          = "myADCA";
adc1.adcClockPrescaler              = "ADC_CLK_DIV_2_0";
adc1.interruptPulseMode             = "ADC_PULSE_END_OF_CONV";
adc1.socHighPriorityMode            = "ADC_PRI_ALL_HIPRI";
adc1.enabledSOCs                    = ["ADC_SOC_NUMBER0","ADC_SOC_NUMBER1","ADC_SOC_NUMBER2"];
adc1.enabledInts                    = ["ADC_INT_NUMBER1"];
adc1.enabledPPBs                    = ["ADC_PPB_NUMBER1","ADC_PPB_NUMBER2","ADC_PPB_NUMBER3"];
adc1.soc0Name                       = "SOC0_Udc";
adc1.soc0Trigger                    = "ADC_TRIGGER_EPWM1_SOCA";
adc1.soc0SampleWindow               = 12;
adc1.soc1Name                       = "SOC1_Vin";
adc1.soc1Channel                    = "ADC_CH_ADCIN4";
adc1.soc1Trigger                    = "ADC_TRIGGER_EPWM1_SOCA";
adc1.soc1SampleWindow               = 12;
adc1.soc2Name                       = "SOC2_Idc";
adc1.soc2Channel                    = "ADC_CH_ADCIN12";
adc1.soc2Trigger                    = "ADC_TRIGGER_EPWM1_SOCA";
adc1.soc2SampleWindow               = 12;
adc1.enableInterrupt1               = true;
adc1.interrupt1SOCSource            = "ADC_INT_TRIGGER_EOC2";
adc1.enableInterrupt1ContinuousMode = true;
adc1.ppb1HighTripLimit              = 2000;
adc1.ppb1LowTripLimit               = -2000;
