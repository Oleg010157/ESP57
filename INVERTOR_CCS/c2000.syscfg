adc1.ppb2SOCNumber                  = "ADC_SOC_NUMBER1";
adc1.ppb2HighTripLimit              = 4000;
adc1.ppb2ReferenceOffset            = 2048;
adc1.ppb3SOCNumber                  = "ADC_SOC_NUMBER2";
