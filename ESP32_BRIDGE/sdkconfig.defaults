# Значения по умолчанию. Сам sdkconfig в репозиторий не кладётся.

# Плата на столе - ESP32-Core-Board-V2 (ESP32-D0WDQ6, ревизия v0.0).
CONFIG_IDF_TARGET="esp32"

# На плате флеш 4 МБ, по умолчанию сборка считает его двухмегабайтным.
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y

CONFIG_FREERTOS_HZ=1000

# Обработчики ведомого SPI - в IRAM: колбэки post_setup/post_trans зовутся из
# прерывания, и при записи во флеш (NVS для WiFi) кэш отключается.
CONFIG_SPI_SLAVE_ISR_IN_IRAM=y
# Колбэки двигают ножку «есть данные» - gpio_set_level тоже в IRAM.
CONFIG_GPIO_CTRL_FUNC_IN_IRAM=y

# Буферов передачи WiFi вдвое больше умолчания. С 32 в домашней сети (-68 дБм)
# sendto пачками отказывал - 3804 датаграммы, дыры на ленте (10.11.2026).
# Буфер динамический: память занимается, только пока пакет стоит в очереди.
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=64

# Сетевой стек lwIP - на ядро 0, к WiFi. По умолчанию он без привязки и с
# приоритетом 18 выше задачи обмена с прибором (10), а та на ядре 1: под
# трафиком (лента плюс команды от движка Motor_Control) lwIP занимал ядро 1
# дольше 2 мс, мост не успевал перезарядить посылку SPI, и прибор выбрасывал
# кадры ленты - разрывы (15.11.2026). Ядро 1 - целиком под обмен с прибором.
CONFIG_LWIP_TCPIP_TASK_AFFINITY_CPU0=y

# Своя таблица разделов: два места под программу (обновление по WiFi) и раздел
# bbox под записи чёрного ящика - partitions.csv.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"

# Новая прошивка по WiFi сначала пробная: не подтвердила себя - загрузчик
# возвращает прежнюю (main/web.c). Это настройка ЗАГРУЗЧИКА: в силу она
# входит после прошивки по USB, `idf.py flash` - по WiFi загрузчик не меняется.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
